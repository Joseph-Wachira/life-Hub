# Base URL of the Life Hub Next.js app's mobile API (src/app/api/mobile/v1).
# Must be reachable from your phone/simulator, not just your laptop:
#   - iOS Simulator: http://localhost:3000 works (shares the Mac's network stack).
#   - Android Emulator: use http://10.0.2.2:3000 instead of localhost.
#   - Physical device (Expo Go / dev build): use your machine's LAN IP,
#     e.g. http://192.168.1.23:3000 — find it with `ipconfig` (Windows) or
#     `ifconfig`/`ipconfig getifaddr en0` (macOS), and make sure the device
#     is on the same Wi-Fi network as your machine.
EXPO_PUBLIC_API_URL="http://localhost:3000/api/mobile/v1"
