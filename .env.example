# SQLite by default. For production, point this at Postgres/MySQL —
# the schema uses no SQLite-only features, so no model changes are needed.
DATABASE_URL="file:./dev.db"

# Auth.js session encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Base URL of the deployed app (used by Auth.js for callback URLs).
NEXTAUTH_URL="http://localhost:3000"

# Signs/verifies bearer JWTs issued to the mobile app (src/lib/mobile/jwt.ts).
# Deliberately a *different* secret than AUTH_SECRET — the mobile app never
# sees the web session cookie, and rotating one shouldn't force-expire the
# other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOBILE_JWT_SECRET="replace-with-a-random-32-byte-base64-secret"
